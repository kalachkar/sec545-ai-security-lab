{
  "type": "object",
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "attacker_position": { "type": "string", "enum": ["remote_unauth", "remote_auth_low", "remote_auth_privileged", "local_network", "localhost", "none"] },
          "boundary_crossed": { "type": "string" },
          "impact": { "type": "string" },
          "likelihood": { "type": "string", "enum": ["high", "medium", "low"] },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low", "ignore"] },
          "decision": { "type": "string", "enum": ["reportable", "deferred", "ignore"] },
          "rationale": { "type": "string" }
        },
        "required": ["id", "attacker_position", "severity", "decision", "rationale"]
      }
    },
    "chains": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "steps": { "type": "array", "items": { "type": "string" } },
          "attacker_start": { "type": "string" },
          "narrative": { "type": "string" },
          "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
          "impact": { "type": "string" }
        },
        "required": ["id", "title", "steps", "narrative", "severity", "impact"]
      }
    }
  },
  "required": ["findings", "chains"]
}
